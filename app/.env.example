# Local development only. On EC2, everything except DB_PASSWORD_PARAM is set
# via the launch template's user data / instance environment, and the actual
# password is pulled at startup from SSM Parameter Store (see aws-console-steps.md).

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=spice_route_kitchen
DB_USER=spiceroute_app

# Local dev: set the real password directly.
DB_PASSWORD=devpassword

# RDS requires SSL; local Postgres usually doesn't have it enabled, so turn
# it off for local dev only. Leave unset (defaults to true) on EC2.
DB_SSL=false

# On EC2: instead of DB_PASSWORD, set this to the SSM parameter name and the
# app will fetch the decrypted value at startup using the instance's IAM role.
# DB_PASSWORD_PARAM=/spice-route-kitchen/db/password

AWS_REGION=us-east-2
